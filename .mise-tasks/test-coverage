#!/usr/bin/env bash
set -euo pipefail

PACKAGES=("$@")
if [ ${#PACKAGES[@]} -eq 0 ]; then
    PACKAGES=(./... ./jsonschema/oas3/tests/... ./openapi/linter/customrules/... ./openapi/linter/converter/tests/...)
fi

echo "🧪 Running tests with coverage using gotestsum..."
# Count library code exercised by tests in other packages, not just its own tests.
gotestsum --format testname -- -race -coverpkg=./... -coverprofile=coverage.out -covermode=atomic "${PACKAGES[@]}"

# Keep the existing library scope and merge repeated cross-package blocks.
echo "🔧 Filtering cmd and tests folders and merging coverage blocks..."
awk '
NR == 1 { mode = $0; next }
$1 !~ /\/cmd\/|\/tests\// {
    statements[$1] = $2;
    hits[$1] += $3;
}
END {
    print mode;
    for (block in statements) print block, statements[block], hits[block];
}' coverage.out > coverage.filtered.out
mv coverage.filtered.out coverage.out

CURRENT_COV=$(go tool cover -func=coverage.out | awk '/^total:/ {print $NF}')
echo ""
./.github/scripts/format-coverage.sh coverage.out "$CURRENT_COV"
echo ""
echo "## 🎯 **TOTAL STATEMENT COVERAGE: \`$CURRENT_COV\`**"
echo ""

go tool cover -html=coverage.out -o coverage.html
echo "📊 Coverage report generated: coverage.html"
echo "✅ Tests with coverage completed!"
